@page
@model Autoszerviz.Pages.Ugyfelek.CreateModel

@{
    ViewData["Title"] = "Új ügyfél";
}

<h1>Új ügyfél</h1>
<hr />

<div class="row">
    <div class="col-md-5">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Ugyfel.Nev" class="form-label"></label> <span class="text-danger">*</span>
                <input asp-for="Ugyfel.Nev" class="form-control" />
                <span asp-validation-for="Ugyfel.Nev" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Ugyfel.Telefon" class="form-label"></label>
                <input asp-for="Ugyfel.Telefon" class="form-control" placeholder="+36 30 123 4567" />
                <span asp-validation-for="Ugyfel.Telefon" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Ugyfel.Email" class="form-label"></label>
                <input asp-for="Ugyfel.Email" class="form-control" placeholder="pelda@email.hu" />
                <span asp-validation-for="Ugyfel.Email" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Mentés</button>
            <a asp-page="./Index" class="btn btn-secondary">Mégse</a>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
