@page
@model Autoszerviz.Pages.Ugyfelek.IndexModel

@{
    ViewData["Title"] = "Ügyfelek";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Ügyfelek</h1>
    <a asp-page="Create" class="btn btn-primary">+ Új ügyfél</a>
</div>

@if (TempData["Uzenet"] is string uzenet)
{
    <div class="alert alert-success">@uzenet</div>
}

@if (TempData["Hiba"] is string hiba)
{
    <div class="alert alert-danger">@hiba</div>
}

@if (Model.Ugyfelek.Count == 0)
{
    <p class="text-muted">Még nincs rögzített ügyfél.</p>
}
else
{
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>@Html.DisplayNameFor(model => model.Ugyfelek[0].Nev)</th>
                <th>@Html.DisplayNameFor(model => model.Ugyfelek[0].Telefon)</th>
                <th>@Html.DisplayNameFor(model => model.Ugyfelek[0].Email)</th>
                <th>Javítások</th>
                <th class="text-end">Műveletek</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Ugyfelek)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.Nev)</td>
                    <td>@(item.Telefon ?? "-")</td>
                    <td>@(item.Email ?? "-")</td>
                    <td>@item.Javitasok.Count db</td>
                    <td class="text-end">
                        <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Részletek</a>
                        <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Szerkesztés</a>
                        <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Törlés</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
