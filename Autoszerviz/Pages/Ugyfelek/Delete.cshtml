@page
@model Autoszerviz.Pages.Ugyfelek.DeleteModel

@{
    ViewData["Title"] = "Ügyfél törlése";
}

<h1>Ügyfél törlése</h1>
<hr />

@if (Model.JavitasokSzama > 0)
{
    <div class="alert alert-danger">
        Ez az ügyfél nem törölhető, mert @Model.JavitasokSzama javítás tartozik hozzá.
    </div>
}
else
{
    <div class="alert alert-warning">Biztosan törölni szeretnéd ezt az ügyfelet?</div>
}

<dl class="row">
    <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Ugyfel.Nev)</dt>
    <dd class="col-sm-10">@Model.Ugyfel.Nev</dd>

    <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Ugyfel.Telefon)</dt>
    <dd class="col-sm-10">@(Model.Ugyfel.Telefon ?? "-")</dd>

    <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Ugyfel.Email)</dt>
    <dd class="col-sm-10">@(Model.Ugyfel.Email ?? "-")</dd>
</dl>

<form method="post">
    <input type="hidden" asp-for="Ugyfel.Id" />
    @if (Model.JavitasokSzama == 0)
    {
        <button type="submit" class="btn btn-danger">Törlés</button>
    }
    <a asp-page="./Index" class="btn btn-secondary">Vissza</a>
</form>
