@page
@model Autoszerviz.Pages.Ugyfelek.DetailsModel

@{
    ViewData["Title"] = "Ügyfél adatai";
}

<h1>@Model.Ugyfel.Nev</h1>
<hr />

<dl class="row">
    <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Ugyfel.Telefon)</dt>
    <dd class="col-sm-10">@(Model.Ugyfel.Telefon ?? "-")</dd>

    <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Ugyfel.Email)</dt>
    <dd class="col-sm-10">@(Model.Ugyfel.Email ?? "-")</dd>
</dl>

<div>
    <a asp-page="./Edit" asp-route-id="@Model.Ugyfel.Id" class="btn btn-primary">Szerkesztés</a>
    <a asp-page="./Index" class="btn btn-secondary">Vissza a listához</a>
</div>
